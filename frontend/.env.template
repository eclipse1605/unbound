# Template for environment variables - copy this to .env.local
# The URL to your subgraph deployment
NEXT_PUBLIC_GRAPH_API=https://api.thegraph.com/subgraphs/name/your-username/unbound

# IPFS gateway for fetching content
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# Fallback gateways in order of preference (comma-separated)
NEXT_PUBLIC_IPFS_FALLBACK_GATEWAYS=https://ipfs.io/ipfs,https://cloudflare-ipfs.com/ipfs,https://ipfs.fleek.co/ipfs

# Pinata API Keys - required for uploading content to IPFS
NEXT_PUBLIC_PINATA_API_KEY=your-pinata-api-key
NEXT_PUBLIC_PINATA_SECRET_API_KEY=your-pinata-secret-key
